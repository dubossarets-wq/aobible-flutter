<?xml version="1.0" encoding="utf-8"?>
<!-- Резервная копия и перенос на новый телефон (Android 12+): только данные человека — как backup_rules.xml.
     Модули не копируем: скачиваются заново при первом запуске. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="FlutterSharedPreferences.xml" />
        <include domain="root" path="app_webview/Default/Local Storage/" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="FlutterSharedPreferences.xml" />
        <include domain="root" path="app_webview/Default/Local Storage/" />
    </device-transfer>
</data-extraction-rules>
